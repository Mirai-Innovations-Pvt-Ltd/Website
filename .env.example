# Contact form email delivery — server-side only, never NEXT_PUBLIC_*.
# Copy to .env.local and fill in; .env* files are gitignored.

# Required: API key from https://resend.com (verify the
# miraiinnovations.tech domain there first).
RESEND_API_KEY=

# Required: the verified sender identity submissions are sent FROM.
# Replies go to the form submitter via Reply-To automatically.
CONTACT_FROM_EMAIL="Mirai Website <noreply@miraiinnovations.tech>"

# Optional: recipient override. Defaults to hello@miraiinnovations.tech.
CONTACT_TO_EMAIL=
