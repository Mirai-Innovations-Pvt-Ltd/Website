// miraiinnovations.tech on Cloudflare Workers. site/ is served as static assets (headers from site/_headers);
// the script in worker/ only answers /api/* (the pilot sheet). GitHub Actions deploys it (.github/workflows/deploy.yml):
// a push to main goes live, a push to staging updates the test version's preview link.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "mirai-website",
  "account_id": "3d97d94daf750cda4e6a08c9cb3d9db0",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "observability": { "enabled": true }
}
